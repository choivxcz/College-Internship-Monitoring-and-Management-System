NODE_ENV=development
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# Local development uses SQLite, so no database server is needed.
# For MySQL, set DB_DIALECT=mysql and fill in the DB_* values below.
DB_DIALECT=sqlite
DB_STORAGE=./data/internship_hub.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=internship_hub
DB_USER=root
DB_PASSWORD=
# Seed creates accounts only when absent; it never changes existing passwords.
ADMIN_EMAIL=admin@lspu.edu.ph
ADMIN_NAME=Internship Coordinator
ADMIN_PASSWORD=
# Optional fictional data and student account, disabled by default.
SEED_DEMO=false
DEMO_STUDENT_PASSWORD=
